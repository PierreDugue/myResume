{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "commands": [
          "tsc --noEmit -p apps/backend/tsconfig.app.json",
          "tsc --noEmit -p apps/backend/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "migration-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:generate -d apps/backend/src/app/database/data-source.ts apps/backend/src/app/database/migrations/{args.name}",
        "env": {
          "TS_NODE_PROJECT": "apps/backend/tsconfig.app.json"
        }
      }
    },
    "migration-create": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:create apps/backend/src/app/database/migrations/{args.name}",
        "env": {
          "TS_NODE_PROJECT": "apps/backend/tsconfig.app.json"
        }
      }
    },
    "migration-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:run -d apps/backend/src/app/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/backend/tsconfig.app.json"
        }
      }
    },
    "migration-revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:revert -d apps/backend/src/app/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/backend/tsconfig.app.json"
        }
      }
    },
    "migration-show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:show -d apps/backend/src/app/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/backend/tsconfig.app.json"
        }
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/backend/vitest.int.config.mts"
      }
    }
  }
}
