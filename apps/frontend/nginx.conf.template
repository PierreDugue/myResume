# Template: at startup the nginx image fills in the BACKEND_URL, PROXY_SECRET and
# NGINX_LOCAL_RESOLVERS variables
# (only variables defined in the environment are replaced; nginx's own $vars are left alone)
# and writes the result to /etc/nginx/conf.d/default.conf. See apps/frontend/Dockerfile.

server {
    listen 80;
    server_name localhost;
    server_tokens off;

    # The visitor's IP. Behind a hosting platform's proxies (Render), the connection comes from
    # the platform and the visitor is in X-Forwarded-For: read it from the right, skipping the
    # private-network proxies, so addresses a visitor adds themselves (on the left) are ignored.
    # $remote_addr (access log, X-Client-IP below) is then the visitor.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Security headers. The admin token lives in localStorage, so the CSP is the main defense
    # against XSS: scripts only from this site (no inline scripts, see public/theme-init.js).
    # Inline styles stay allowed: Angular component styles and ECharts use them.
    # img-src allows https: for profile and project images hosted elsewhere.
    # 'always' keeps the headers on error responses too. nginx drops server-level add_header in a
    # location that sets its own, so locations below must not use add_header.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    # Browsers only use HTTPS for this site from then on (a year). The site is served over HTTPS
    # by the platform (Render) or Caddy (docker-compose.prod.yml). Browsers ignore this header on
    # plain-HTTP responses, so local Docker on http://localhost is unaffected. No includeSubDomains:
    # other subdomains of the domain aren't ours to decide.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # API and WebSockets (Socket.IO at /api/socket.io) -> NestJS at BACKEND_URL:
    # http://backend:3000 in Docker Compose, the backend's https://….onrender.com address on Render.
    # The request path is passed unchanged: the backend uses /api as its global prefix.
    location /api/ {
        # proxy_pass through a variable makes nginx look the backend up again (every 30 s) instead
        # of only at startup: hosted platforms can change the address behind a hostname.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        # Host and TLS name of the backend itself (not the visitor-facing host), so a platform that
        # routes by hostname, like Render, reaches the right service. The visitor's host is kept
        # in X-Forwarded-Host.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header X-Real-IP $remote_addr;
        # Shared secret and visitor IP, checked by the backend's TrustedProxyGuard when it has
        # PROXY_SECRET (Render, where the backend has a public address). Replaces any value the
        # visitor sent. An empty PROXY_SECRET (the default) sends no secret header.
        proxy_set_header X-Proxy-Secret "${PROXY_SECRET}";
        proxy_set_header X-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 1h;
    }
}
