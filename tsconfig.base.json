{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@my-resume/api-models": ["./libs/shared/api-models/src/index.ts"],
      "@my-resume/resume-metrics": ["./libs/shared/resume-metrics/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
