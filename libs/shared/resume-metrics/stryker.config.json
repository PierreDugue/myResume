{
  "$schema": "../../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "libs/shared/resume-metrics/vitest.config.mts",
    "related": false
  },
  "mutate": [
    "libs/shared/resume-metrics/src/**/*.ts",
    "!libs/shared/resume-metrics/src/**/*.spec.ts",
    "!libs/shared/resume-metrics/src/**/fixtures.ts"
  ],
  "checkers": ["typescript"],
  "tsconfigFile": "libs/shared/resume-metrics/tsconfig.lib.json",
  "coverageAnalysis": "perTest",
  "disableBail": true,
  "incremental": true,
  "incrementalFile": "coverage/resume-metrics/mutation/incremental.json",
  "htmlReporter": {
    "fileName": "coverage/resume-metrics/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/resume-metrics/mutation/report.json"
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "tempDirName": "tmp/stryker"
}
